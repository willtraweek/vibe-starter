#!/bin/sh
# Runs once at the end of ./bootstrap --stack foldkit, from the project root.
# 1. Install the reviewed dependency tree from the pack's pnpm-lock.yaml. The
#    root `prepare` script runs `effect-tsgo patch`, so tsc enforces the Effect
#    rules from the first check.
# 2. Vendor Foldkit's source into repos/foldkit (gitignored) for agents.
# Both need the network; an offline failure is recoverable, interruption stops.
#
if ! command -v perl >/dev/null 2>&1; then
  echo "Perl is not installed: install Perl (including its core POSIX and Errno modules) for the bounded network commands." >&2
  exit 1
fi
# pnpm 12 reads pnpm_config_* and PNPM_CONFIG_* settings from the environment
# over pnpm-workspace.yaml: clear the supply-chain ones, so the install resolves
# under the file's policy (scripts/check.d/foldkit.sh clears the same list).
for setting in minimum_release_age minimum_release_age_exclude minimum_release_age_exclude_prune \
  minimum_release_age_ignore_missing_time minimum_release_age_strict trust_lockfile trust_policy \
  trust_policy_exclude trust_policy_exclude_prune trust_policy_ignore_after strict_dep_builds \
  block_exotic_subdeps allow_builds dangerously_allow_all_builds; do
  unset "pnpm_config_$setting" "PNPM_CONFIG_$(printf '%s' "$setting" | tr '[:lower:]' '[:upper:]')"
done
# Bound the install's whole process group: offline, pnpm can wait a long time.
# FOLDKIT_TEST_TIMEOUT shortens the limit for the template's tests.
limit="${FOLDKIT_TEST_TIMEOUT:-600}"
bounded_pid=''
install_status="$(mktemp "${TMPDIR:-/tmp}/foldkit-install-status.XXXXXX")" || exit 1
trap 'rm -f "$install_status"' EXIT
# One complete outcome record must agree with the observed exit, including 0.
# A second line or unterminated trailing data is invalid, even if the first fits.
read_outcome() {
  bounded_outcome='' outcome_extra=''
  { IFS= read -r bounded_outcome && ! IFS= read -r outcome_extra && [ -z "$outcome_extra" ]; } < "$1" || return 1
  # Shell read may discard NUL bytes; compare the exact ASCII record length.
  [ "$(wc -c < "$1")" -eq "$((${#bounded_outcome} + 1))" ] || return 1
  case "$bounded_outcome" in
    "exit $2") return 0 ;;
    "signal $2") [ "$2" -gt 128 ] && [ "$2" -le 255 ] ;;
    'timeout 142') [ "$2" = 142 ] ;;
    'internal 125') [ "$2" = 125 ] ;;
    *) return 1 ;;
  esac
}
interrupted() {
  trap '' HUP INT TERM
  if [ -n "$bounded_pid" ]; then
    # Background shells can inherit INT ignored; TERM reliably requests cleanup.
    kill -TERM "$bounded_pid" 2>/dev/null || :
    wait "$bounded_pid" 2>/dev/null || :
  fi
  exit "$2"
}
trap 'interrupted HUP 129' HUP
trap 'interrupted INT 130' INT
trap 'interrupted TERM 143' TERM
run_step() {
  "$@" <&0 &
  bounded_pid=$!
  wait "$bounded_pid"
  install_rc=$?
  bounded_pid=''
  return "$install_rc"
}
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm not found: install pnpm 12 (https://pnpm.io/installation), then run 'pnpm install'."
else
  install_rc=0
  run_step perl scripts/bounded-command.pl --status-file "$install_status" "$limit" pnpm install --frozen-lockfile || install_rc=$?
  if ! read_outcome "$install_status" "$install_rc"; then
    echo "The command supervisor returned no valid outcome: check Perl and scripts/bounded-command.pl (exit $install_rc)." >&2
    exit 1
  fi
  case "$bounded_outcome" in
    'exit 0') echo "Installed the locked dependencies (tsc is patched by @effect/tsgo)." ;;
    signal\ *) exit "$install_rc" ;;
    internal\ *) echo "The command supervisor failed: check its error above." >&2; exit 1 ;;
    'timeout 142') echo "pnpm install timed out after ${limit}s (offline?): run 'pnpm install --frozen-lockfile' before your first commit." ;;
    *) echo "pnpm install failed (exit $install_rc; see above): check command startup, network access and pnpm's error, then run 'pnpm install --frozen-lockfile'." ;;
  esac
fi
# vendor-foldkit.sh says what it needs (git, the network, Node 22 or newer).
if command -v git >/dev/null 2>&1 && run_step bash scripts/vendor-foldkit.sh; then
  :
else
  vendor_rc=$?
  case "$vendor_rc" in 129|130|143) exit "$vendor_rc" ;; esac
  echo "Vendoring Foldkit failed (offline?): run 'bash scripts/vendor-foldkit.sh' later; ./scripts/check.sh warns until you do."
fi
echo "Once per machine, for the E2E journeys: pnpm exec playwright install chromium"
