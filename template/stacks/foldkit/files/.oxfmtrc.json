{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] }
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "repos",
    "test-results",
    "playwright-report",
    "blob-report",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "package.json",
    "**/*.md"
  ]
}
