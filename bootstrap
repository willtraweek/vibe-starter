#!/usr/bin/env bash
# vibe-starter bootstrap — run once on a fresh clone to personalize the template.
#
# Usage:
#   ./bootstrap                         # interactive (prompts for the name)
#   ./bootstrap --name my-project       # non-interactive name
#   ./bootstrap --name my-project --yes # no prompts at all
#   ./bootstrap --name my-project --stack python --yes # also install a stack pack
#   ./bootstrap --force --name my-project # run anyway where bootstrap refuses (exit 3)
#
# It replaces the bootstrap-owned placeholders ({{PROJECT_NAME}}, {{YEAR}}),
# initializes git if needed, optionally notes gstack, prints a checklist of the
# placeholders you still need to hand-fill, then deletes itself and the
# template-only paths (TEMPLATE.md, template/, the template self-test, plans/).
# It also installs the project's own VERSION / CHANGELOG.md / TODOS.md from
# template/skeleton/ and strips <!-- template-only --> markdown blocks.
#
# Stack packs are optional (template/stacks/<name>/, see TEMPLATE.md). With
# --stack <name> (or a pick at the interactive prompt) it also copies the pack's
# files, fills the command placeholders ({{TEST_CMD}}, ...) from its `commands`,
# swaps .gitignore's language sections for the pack's, activates its CI and runs
# its best-effort after-bootstrap hook. Without one the project stays stack-agnostic.
#
# The default name is the repo name of the `origin` remote, else the directory
# name. Exit codes: 0 done (or already bootstrapped), 1 failed (a malformed
# template-only marker, a missing skeleton, an invalid template version or a
# stack pack's broken `includes` is caught before any change; after a later
# failure, fix it and rerun with the same arguments), 2 usage or name error,
# 3 refused because this is the vibe-starter template repo itself, or git can't
# read this directory's .git.
set -euo pipefail

cd "$(dirname "$0")"
ROOT="$(pwd)"

# --- Re-entry guard (must be first) -----------------------------------------
if [ -f .bootstrapped ]; then
  echo "Already bootstrapped ($(cat .bootstrapped)). Nothing to do."
  exit 0
fi

# --- Stack packs, listed by --help and the prompt ---------------------------
# One line per pack: its name and the one-line `description` of what it builds,
# in the order the prompt offers them.
list_stacks() {
  local name
  [ -d template/stacks ] || return 0
  find template/stacks -mindepth 1 -maxdepth 1 -type d ! -name '_*' -exec basename {} \; | LC_ALL=C sort \
    | while IFS= read -r name; do
        printf '  %-15s %s\n' "$name" "$(head -n 1 "template/stacks/$name/description" 2>/dev/null || true)"
      done
}

# --- Parse args -------------------------------------------------------------
NAME=""
NAME_GIVEN=0
STACK=""
STACK_GIVEN=0
ASSUME_YES=0
FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name)
      if [ $# -lt 2 ]; then echo "--name needs a value" >&2; exit 2; fi
      NAME="$2"; NAME_GIVEN=1; shift 2 ;;
    --name=*) NAME="${1#*=}"; NAME_GIVEN=1; shift ;;
    --stack)
      if [ $# -lt 2 ]; then echo "--stack needs a value" >&2; exit 2; fi
      STACK="$2"; STACK_GIVEN=1; shift 2 ;;
    --stack=*) STACK="${1#*=}"; STACK_GIVEN=1; shift ;;
    --yes|-y) ASSUME_YES=1; shift ;;
    --force)  FORCE=1; shift ;;
    -h|--help)
      echo "Usage: ./bootstrap [--name <project>] [--stack <name>] [--yes] [--force]"
      if [ -d template/stacks ]; then
        echo
        echo "Stack packs (--stack <name>; without one the project stays stack-agnostic):"
        list_stacks
      fi
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done
if [ "$NAME_GIVEN" = "1" ] && [ -z "$NAME" ]; then
  echo "--name needs a non-empty value" >&2
  exit 2
fi
if [ "$STACK_GIVEN" = "1" ] && [ -z "$STACK" ]; then
  echo "--stack needs a non-empty value" >&2
  exit 2
fi

# --- Is this directory its own git repo? ------------------------------------
# `git rev-parse`, not `[ -d .git ]`: in worktrees and submodules .git is a
# file. Only this directory's own repo counts: git also finds an enclosing
# repo, which belongs to a different project. `-ef` compares inodes, so
# symlinked paths (macOS /tmp -> /private/tmp) and case-insensitive
# filesystems still match.
TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"
OWN_REPO=0
if [ -n "$TOPLEVEL" ] && [ "$TOPLEVEL" -ef . ]; then OWN_REPO=1; fi

# A .git that git can't read (corrupt, a dangling symlink or gitfile, or owned
# by another user) hides origin, so the template refusal below can't fire.
# Refuse instead of personalizing what may still be someone's repository.
if { [ -e .git ] || [ -L .git ]; } && [ "$OWN_REPO" != "1" ] && [ "$FORCE" != "1" ]; then
  GIT_ERR="$(git rev-parse --show-toplevel 2>&1 >/dev/null || true)"
  # Inside another repo, git skips an invalid .git without an error.
  [ -n "$GIT_ERR" ] || GIT_ERR="git ignores it: not a valid repository"
  echo "Refusing to run: there is a .git here that git can't read:" >&2
  echo "  ${GIT_ERR//$'\n'/$'\n'  }" >&2
  echo "Fix the repository (see the error above), or pass --force if you really mean it." >&2
  exit 3
fi

# --- Refuse to personalize the template itself ------------------------------
# Default name source: the `origin` remote's repo name. NOT the directory name
# alone: in a Conductor workspace that is the workspace codename (e.g.
# "montreal"), which is never the project's name.
remote_repo_name() {
  local url
  [ "$OWN_REPO" = "1" ] || return 0
  url="$(git remote get-url origin 2>/dev/null)" || return 0
  # Drop user:token@ so a URL with no repo path can't turn a token into a name.
  case "$url" in *://*@*) url="${url%%://*}://${url#*://*@}" ;; esac
  # Strip trailing /, /., /.. and .git (any case, any order) so .../widget/,
  # .../widget.GIT// and a local .../widget.git/.git/. all give "widget".
  while :; do
    case "$url" in
      */) url="${url%/}" ;;
      */.) url="${url%/.}" ;;
      */..) url="${url%/..}"; url="${url%/*}" ;;
      *.[Gg][Ii][Tt]) url="${url%????}" ;;
      *) break ;;
    esac
  done
  printf '%s\n' "${url##*[/:]}"
}
REMOTE_NAME="$(remote_repo_name)"
# Case-insensitive (GitHub URLs are) without tr, whose case mapping depends on
# the locale. The message never echoes the URL, which can carry a token.
case "$REMOTE_NAME" in
  [Vv][Ii][Bb][Ee]-[Ss][Tt][Aa][Rr][Tt][Ee][Rr])
    if [ "$FORCE" != "1" ]; then
      echo "Refusing to run: this looks like the vibe-starter template repo itself" >&2
      echo "(origin repo: $REMOTE_NAME). Run ./bootstrap in a repo created from the" >&2
      echo "template, or point origin at your own repo and rerun:" >&2
      echo "  git remote set-url origin <your-repo-url>" >&2
      echo "To personalize this copy anyway, pass --force --name <project>." >&2
      exit 3
    else
      echo "Warning: --force: origin still points at the vibe-starter template." >&2
      echo "Point it at your own repo before you push:" >&2
      echo "  git remote set-url origin <your-repo-url>" >&2
    fi ;;
esac

# --- Project name -----------------------------------------------------------
default="${REMOTE_NAME:-$(basename "$ROOT")}"
if [ -z "$NAME" ]; then
  if [ "$ASSUME_YES" = "1" ] || [ ! -t 0 ]; then
    NAME="$default"
  else
    printf "Project name [%s]: " "$default"
    read -r NAME </dev/tty || NAME=""
    [ -z "$NAME" ] && NAME="$default"
  fi
fi
# A rejected default should say where it came from and how to override it.
NAME_HINT=""
if [ "$NAME_GIVEN" != "1" ] && [ "$NAME" = "$default" ]; then
  if [ -n "$REMOTE_NAME" ]; then from="the origin remote"; else from="the directory name"; fi
  NAME_HINT=" (from $from; pass --name <project>)"
fi
# Enumerated, not A-Za-z0-9 ranges: bracket ranges collate per-locale (macOS
# bash 3.2 under en_US.UTF-8 folds accented letters into A-Za-z), so spelling
# the set out keeps both checks ASCII-only on every platform and locale.
case "$NAME" in
  [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) ;;
  *) echo "Project name must start with a letter or digit: '$NAME'$NAME_HINT" >&2; exit 2 ;;
esac
case "$NAME" in
  *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._\ -]*) echo "Project name has unexpected characters: '$NAME'$NAME_HINT" >&2; exit 2 ;;
esac

# --- Stack pack preflight (optional; no writes) -----------------------------
STACKS=""
if [ -d template/stacks ]; then
  STACKS="$(find template/stacks -mindepth 1 -maxdepth 1 -type d ! -name '_*' -exec basename {} \; \
    | LC_ALL=C sort | tr '\n' ' ' | sed 's/ *$//')"
fi
# A retry finishes the stack the first attempt chose (saved next to the template
# version below); the prompt's default, none, must not quietly replace it.
SAVED_STACK=""
HAVE_SAVED_STACK=0
if [ -f template/.bootstrap-stack ]; then
  SAVED_STACK="$(cat template/.bootstrap-stack)"
  HAVE_SAVED_STACK=1
fi
if [ "$STACK_GIVEN" = "0" ] && [ "$HAVE_SAVED_STACK" = "1" ]; then
  STACK="$SAVED_STACK"
elif [ "$STACK_GIVEN" = "0" ] && [ "$ASSUME_YES" != "1" ] && [ -t 0 ] && [ -n "$STACKS" ]; then
  echo "Stack packs (none keeps the project stack-agnostic):"
  list_stacks
  printf "Stack pack [none %s]: " "$STACKS"
  read -r STACK </dev/tty || STACK=""
fi
if [ "$STACK" = "none" ]; then STACK=""; fi
if [ "$HAVE_SAVED_STACK" = "1" ] && [ "$STACK" != "$SAVED_STACK" ]; then
  if [ -n "$SAVED_STACK" ]; then was="--stack $SAVED_STACK"; else was="no stack pack"; fi
  echo "This bootstrap was started with $was; rerun it with the same arguments to finish." >&2
  exit 2
fi
# Normalization is shared; reserved words are language-specific. Letters are
# enumerated for the same locale reason as the name checks above.
PACKAGE_NAME="$(printf '%s' "$NAME" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//')"
if [ -n "$STACK" ]; then
  case "$STACK" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*|[-_]*) echo "Invalid stack name '$STACK'" >&2; exit 2 ;;
  esac
  pack="template/stacks/$STACK"
  if [ ! -d "$pack/files" ] || [ ! -f "$pack/commands" ] || [ ! -f "$pack/gitignore" ]; then
    echo "Unknown stack '$STACK' (available: ${STACKS:-none})" >&2
    exit 2
  fi
  # A pack may include partial packs (template/stacks/_name/files/), copied
  # before its own files so shared files live once. Checked before any write.
  if [ -f "$pack/includes" ]; then
    while IFS= read -r part || [ -n "$part" ]; do
      case "$part" in ''|'#'*) continue ;; esac
      case "$part" in
        _|[!_]*|_*[!abcdefghijklmnopqrstuvwxyz0123456789_-]*)
          echo "Invalid include '$part' in $pack/includes: name a partial pack, _name" >&2; exit 1 ;;
      esac
      if [ ! -d "template/stacks/$part/files" ]; then
        echo "$pack/includes names '$part', which has no files/" >&2
        exit 1
      fi
    done < "$pack/includes"
  fi
  case "$PACKAGE_NAME" in
    [abcdefghijklmnopqrstuvwxyz]*) ;;
    *) echo "With a stack pack the project name must start with a letter: '$NAME'$NAME_HINT" >&2; exit 2 ;;
  esac
  if [ -f "$pack/validate-name" ]; then
    sh "$pack/validate-name" "$PACKAGE_NAME" "$NAME" || { [ -z "$NAME_HINT" ] || echo "Name '$NAME'$NAME_HINT" >&2; exit 2; }
  fi
fi
YEAR="$(date +%Y)"
echo "Personalizing template -> name='$NAME', year='$YEAR'"

# --- Validate template-only markers before any writes -----------------------
# Same rules as template_markers_valid in scripts/template-selftest.sh. A
# marker the strip below would miss (indented 1-3 spaces, spacing, trailing
# text or CRLF) is an error here, so a block can't silently ship. Four spaces
# or a tab make an indented code example, which is left alone.
validate_template_markers() {
  awk '
    /^(   |  | )?<!--[ \t]*template-only/ && !/^<!-- template-only:(start|end) -->$/ {
      print FILENAME ":" FNR ": template-only marker must be alone on its line, at column 0" > "/dev/stderr"
      bad=1; next
    }
    /^<!-- template-only:start -->$/ {
      if (inside) { print FILENAME ": nested template-only start" > "/dev/stderr"; bad=1 }
      inside=1; next
    }
    /^<!-- template-only:end -->$/ {
      if (!inside) { print FILENAME ": unmatched template-only end" > "/dev/stderr"; bad=1 }
      inside=0
    }
    END {
      if (inside) { print FILENAME ": unclosed template-only start" > "/dev/stderr"; bad=1 }
      exit bad
    }
  ' "$1"
}
# The markdown both the validate and the strip pass cover; they must see the
# same files. Only the root plans/ is template-only, and a nested checkout
# (a worktree or submodule, whose .git may be a file) is another repo: skip it
# (the placeholder pass below does not, yet). Piped (not < <(...)) so pipefail
# stops bootstrap when find can't read a directory.
markdown_files() {
  find . \( -path ./plans -o -type d \( -name .git -o -name .context \
    -o -name node_modules -o -name .venv -o -name target -o -name dist \) \
    -o -type d ! -path . -exec test -e '{}/.git' \; \) -prune \
    -o -type f -name '*.md' -print0
}
markdown_files | while IFS= read -r -d '' f; do
  validate_template_markers "$f" || exit 1
done

# --- Swap in the project skeletons, retaining the template version on retry --
# Save provenance outside root VERSION: the first copy replaces VERSION with 0.0.0.
# Retry the same bootstrap arguments after fixing a failed operation.
for f in VERSION CHANGELOG.md TODOS.md; do
  [ -f "template/skeleton/$f" ] || { echo "Missing skeleton: $f" >&2; exit 1; }
done
if [ -f template/.bootstrap-version ]; then
  VERSION_FROM=template/.bootstrap-version
else
  VERSION_FROM=VERSION
fi
TEMPLATE_VERSION="$(head -n 1 "$VERSION_FROM")"
# Checked before it is saved, so a bad VERSION can't stick across retries.
if ! printf '%s\n' "$TEMPLATE_VERSION" | grep -Eq '^[0-9]+(\.[0-9]+){2,3}$'; then
  echo "Invalid template version in $VERSION_FROM: '$TEMPLATE_VERSION'" >&2
  exit 1
fi
if [ "$VERSION_FROM" = VERSION ]; then
  printf '%s\n' "$TEMPLATE_VERSION" > template/.bootstrap-version.tmp
  mv template/.bootstrap-version.tmp template/.bootstrap-version
fi
if [ "$HAVE_SAVED_STACK" = "0" ]; then
  printf '%s\n' "$STACK" > template/.bootstrap-stack
fi
for f in VERSION CHANGELOG.md TODOS.md; do
  cp "template/skeleton/$f" "$f"
done
echo "Installed the project's own VERSION, CHANGELOG.md and TODOS.md."

# --- Apply the stack pack -----------------------------------------------------
# Copy template/stacks/<stack>/files/ into the project (a path segment named
# __package__ becomes the package name), fill the command placeholders from its
# `commands` file, swap .gitignore's commented language sections for the pack's
# own, and activate the pack's CI workflow in place of ci.yml.example. A retry
# after a later failure repeats this safely: filled placeholders and the swapped
# .gitignore block are not found again.
if [ -n "$STACK" ]; then
  pack="template/stacks/$STACK"
  # Included partial packs first, then the pack itself, so the pack's files win.
  { if [ -f "$pack/includes" ]; then grep -v '^#' "$pack/includes" | grep . || true; fi
    echo "$STACK"; } | while IFS= read -r part; do
    (CDPATH='' cd "template/stacks/$part/files" && find . -type f) | while IFS= read -r src; do
      dest="$(printf '%s' "${src#./}" | PKG="$PACKAGE_NAME" perl -pe 's#(^|/)__package__(?=/|$)#$1$ENV{PKG}#g')"
      mkdir -p "$(dirname "$dest")"
      rm -f "$dest"  # a fresh copy takes its own mode, not an included file's
      cp "template/stacks/$part/files/$src" "$dest"
    done
  done
  # KEY=value lines; values reach perl through the environment, never a shell.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    hits="$(grep -rlIF --exclude=bootstrap --exclude-dir=.git --exclude-dir=template \
      --exclude-dir=node_modules --exclude-dir=.venv --exclude-dir=target --exclude-dir=dist \
      -e "{{$key" . 2>/dev/null || true)"
    [ -n "$hits" ] || continue
    printf '%s\n' "$hits" | while IFS= read -r f; do
      KEY="$key" VAL="${line#*=}" perl -0pi -e \
        's/\{\{\Q$ENV{KEY}\E(?::[^}]*)?\}\}/$ENV{VAL}/g' "$f"
    done
  done < "$pack/commands"
  perl -0pi -e 's/^This template is stack-agnostic\. Fill these in once a stack is chosen, then delete this note\.\n\n?//m' CLAUDE.md
  # Only the commented block goes: rules a user uncommented or appended there stay.
  PACK_GITIGNORE="$(cat "$pack/gitignore")" perl -0pi -e '
    s{\r?\n# =+\r?\n# Language sections.*\z}{
      my @kept = grep { /\S/ && !/^#/ } split /\r?\n/, $&;
      "\n\n$ENV{PACK_GITIGNORE}\n"
        . (@kept ? "\n# --- Kept from before the stack pack ---\n" . join("\n", @kept) . "\n" : "")
    }se' .gitignore
  # No language block matched (it was edited away): append the pack's rules, once.
  missing=0
  while IFS= read -r rule || [ -n "$rule" ]; do
    case "$rule" in ''|'#'*) continue ;; esac
    grep -qxF -- "$rule" .gitignore 2>/dev/null || { missing=1; break; }
  done < "$pack/gitignore"
  if [ "$missing" = 1 ]; then { printf '\n'; cat "$pack/gitignore"; } >> .gitignore; fi
  if [ -f .github/workflows/ci.yml ]; then rm -f .github/workflows/ci.yml.example; fi
  echo "Installed the $STACK stack pack."
fi

# --- Replace bootstrap-owned placeholders -----------------------------------
# Portable in-place edit via perl (uniform on macOS/BSD + Linux). Values are
# passed through the environment so they're never re-interpreted as regex/shell.
# The bootstrap script itself is excluded so its literal tokens survive until
# self-delete.
files="$(grep -rlI \
  --exclude=bootstrap \
  --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=.venv \
  --exclude-dir=target --exclude-dir=dist \
  -e '{{PROJECT_NAME}}' -e '{{YEAR}}' -e '{{PACKAGE_NAME}}' . 2>/dev/null || true)"
if [ -n "$files" ]; then
  printf '%s\n' "$files" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    NAME="$NAME" YEAR="$YEAR" PKG="$PACKAGE_NAME" perl -pi -e \
      's/\Q{{PROJECT_NAME}}\E/$ENV{NAME}/g; s/\Q{{YEAR}}\E/$ENV{YEAR}/g; s/\Q{{PACKAGE_NAME}}\E/$ENV{PKG}/g' "$f"
  done
  echo "Replaced {{PROJECT_NAME}} / {{YEAR}} across the docs."
fi

# --- Strip the validated template-only blocks -------------------------------
markdown_files | while IFS= read -r -d '' f; do
  perl -0pi -e 's/^<!-- template-only:start -->\n.*?^<!-- template-only:end -->(?:\n|\z)\n?//gms' "$f"
done
# perl -i only warns (and exits 0) when it can't rewrite a file, so check.
markdown_files | while IFS= read -r -d '' f; do
  if grep -qE '^<!-- template-only:(start|end) -->$' "$f"; then
    echo "$f: template-only block not removed (can bootstrap write it?)" >&2
    exit 1
  fi
done
echo "Removed template-only blocks."

# --- Stack follow-up (best effort; lockfile absence is reported) ------------
if [ -n "$STACK" ] && [ -f "template/stacks/$STACK/after-bootstrap" ]; then
  sh "template/stacks/$STACK/after-bootstrap" || echo "note: the $STACK pack follow-up failed; see above."
fi

# --- git init (only if this directory is not already a repository root) ------
# OWN_REPO comes from "Is this directory its own git repo?" above. Never
# re-initialize an existing .git, even one git can't read (corrupt, owned by
# another user, or a dangling symlink).
if [ "$OWN_REPO" = "1" ]; then
  echo "Already a git repository - skipped git init."
elif [ -e .git ] || [ -L .git ]; then
  echo "Found a .git that git can't read - left it alone and skipped git init."
elif git init -q; then
  echo "Initialized a fresh git repository."
  if [ -n "$TOPLEVEL" ]; then
    echo "Note: this directory is inside another repository ($TOPLEVEL); it now has its own nested repo."
  fi
else
  echo "git init failed (is git installed?) - skipped."
fi

# --- Optional gstack wiring (guarded; gstack is not on PATH) -----------------
GSTACK_SLUG="$HOME/.claude/skills/gstack/bin/gstack-slug"
if [ -x "$GSTACK_SLUG" ]; then
  eval "$("$GSTACK_SLUG" 2>/dev/null)" 2>/dev/null || true
  echo "gstack detected (slug: ${SLUG:-unknown})."
else
  echo "gstack not found on this machine -> skipped (harmless)."
fi

# --- First-run checklist ----------------------------------------------------
cat <<'CHECKLIST'

Bootstrap done. Hand-fill the placeholders that remain (grep the repo for '{{' ):
  CLAUDE.md   - tagline, architecture, key files, commands, skill routing; read with AGENTS.md
  AGENTS.md   - install command, trust boundary, ship gate, privacy; read with CLAUDE.md
  TESTING.md  - check/test commands, tier modules, API surfaces, NAMED_INVARIANTS, critical journeys
  README.md   - what / why / stack
  TODOS.md    - the first real task
  docs/architecture.md - modules, contracts & invariants
Every agent must read both CLAUDE.md and AGENTS.md once before starting task work.
Before enabling issue intake, review missing type labels and the private reporting contact (docs/guides/filing-issues.md).
Ask the user to confirm the target repository and missing labels before creating any; preserve existing labels.
Commit this to your default branch before you branch or run gstack /ship:
/ship compares VERSION with the base branch, which still has the template's.
CHECKLIST
if [ -n "$STACK" ]; then
  if [ -f .github/workflows/ci.yml ]; then
    echo "Stack pack: $STACK. Commands, CI (.github/workflows/ci.yml) and .gitignore are set up."
  else
    echo "Stack pack: $STACK. Commands and .gitignore are set up; this pack has no CI workflow."
  fi
  echo "  Run the gate before the first push, and commit the lockfile if the pack wrote one; resolve any hook warning first."
  echo "  Delete DESIGN.md and/or MISSION.md if this project doesn't need them."
else
  cat <<'CHECKLIST'
Then choose a stack and:
  - add the build/test files (package.json / pyproject.toml / Cargo.toml ...)
  - uncomment your language section in .gitignore
  - rename .github/workflows/ci.yml.example -> ci.yml and fill in the test command
  - delete DESIGN.md and/or MISSION.md if this project doesn't need them
CHECKLIST
fi

# --- Finalize: drop template-only paths, mark done, self-delete (last) ------
# Template-only paths exist to maintain vibe-starter itself and don't belong in
# a project created from it. Keep this list in sync with TEMPLATE.md. template/
# (the retry state) goes last and .bootstrapped after it, so a failed removal
# can be retried.
TEMPLATE_ONLY="TEMPLATE.md scripts/template-selftest.sh .github/workflows/template-selftest.yml plans template"
for p in $TEMPLATE_ONLY; do rm -rf "$p"; done
printf '%s from vibe-starter %s%s\n' "$(date +%Y-%m-%d)" "$TEMPLATE_VERSION" \
  "${STACK:+ with the $STACK stack pack}" > .bootstrapped
rm -f "$ROOT/bootstrap"
echo "Removed bootstrap. Welcome to $NAME."
