# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Secrets / env (keep the *.example templates) ---
.env
.env.*
!.env.example
!.env.*.example

# --- Logs ---
*.log
logs/

# --- gstack / Conductor local state ---
# Ignore .gstack/ at any depth. Re-include the root directory so the ship
# pre-gate pin can be committed, ignore the rest of that directory, and
# keep nested .gstack/ trees ignored (the omarchy-plugin pack re-includes
# its own pin from template/.gitignore).
.gstack/
!.gstack/
.gstack/*
**/.gstack/*
!.gstack/pregate.json
brain-cache/
# .context/ is local scratch (Conductor handoff space); never committed.
# How the workflow works: docs/context-workflow.md
.context/

# --- Claude Code local overrides (project-shared settings.json stays tracked if you add one) ---
.claude/settings.local.json

